<nav class="navbar sticky-top navbar-expand-md px-2 bg-body">
    <button 
        class="navbar-brand navbar-toggler navbar-toggler-left focus-ring focus-ring-secondary"
        type="button" 
        data-bs-toggle="collapse"
        data-bs-target="#navNav" 
        aria-controls="navNav" 
        aria-expanded="false"
        aria-label="Toggle navigation">
        <img src="/img/earth.svg" alt="" width="28" height="28">
    </button>

    <img class="d-none d-md-block d-lg-block d-xl-block mr-2" src="/img/earth.svg" alt="" width="28" height="28">

    <span class="navbar-text text-right d-sm-block fw-bold d-md-none">{{ pkg.author.name }}</span>

    <div class="d-flex align-items-center ms-auto order-md-last">
        <span class="navbar-text text-right text-nowrap fw-bold d-none d-md-block d-xl-block">{{ pkg.author.name }}</span>
        <button
            id="themeToggle"
            type="button"
            class="btn btn-link nav-link px-2 ms-md-2 focus-ring focus-ring-secondary"
            aria-label="Dark mode"
            aria-pressed="false"
            title="Toggle dark mode">
            <i class="bi bi-moon-stars-fill theme-icon-to-dark" aria-hidden="true"></i>
            <i class="bi bi-sun-fill theme-icon-to-light" aria-hidden="true"></i>
        </button>
    </div>

    <div class="collapse navbar-collapse ms-2" id="navNav">
        <div class="navbar-nav">
        {% for item in site.menu %}
          <a class="nav-item nav-link text-body" href="{{ item.url }}">
            <i class="{{ item.icon }}" aria-hidden="true"></i>
            {{ item.text }}
          </a>
        {%- endfor %}
        </div>
    </div>
</nav>
<script>
    (function () {
        var root = document.documentElement;
        var button = document.getElementById("themeToggle");
        var media = matchMedia("(prefers-color-scheme: dark)");

        function apply(theme) {
            root.setAttribute("data-bs-theme", theme);
            button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
        }

        function stored() {
            try { return localStorage.getItem("theme"); } catch (e) { return null; }
        }

        apply(root.getAttribute("data-bs-theme") === "dark" ? "dark" : "light");

        button.addEventListener("click", function () {
            var next = root.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
            try { localStorage.setItem("theme", next); } catch (e) {}
            apply(next);
        });

        media.addEventListener("change", function (event) {
            if (!stored()) {
                apply(event.matches ? "dark" : "light");
            }
        });
    })();
</script>
